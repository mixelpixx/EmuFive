# Mount USB drives for KytyPS5: the first one goes to /media/ps5-usb, and its
# PS5 folder holds the games.
# Matched by the USB device above the disk, not by ID_BUS: udev runs ata_id on
# external SSDs and hard drives (SATA disks in USB enclosures), which makes
# their ID_BUS "ata", the same as the PS4's internal drive.
ACTION=="add", SUBSYSTEM=="block", SUBSYSTEMS=="usb", ENV{ID_FS_USAGE}=="filesystem", RUN+="/opt/ps5-on-ps4/bin/ps5-usb-mount add $devnode"
# On removal the USB device is already gone; ps5-usb-mount only unmounts the
# drive mounted at /media/ps5-usb.
ACTION=="remove", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", RUN+="/opt/ps5-on-ps4/bin/ps5-usb-mount remove $devnode"
