+// Stores `value` at dword `dword` of the buffer at device address `address`.
+void StoreAddressDword(EmitterState& state, uint32_t address, uint32_t dword, uint32_t value) {
+	const auto offset =
+	    Binary(state, spv::OpShiftLeftLogical, TypeU64(state),
+	           Unary(state, spv::OpUConvert, TypeU64(state), dword), ConstantU64(state, 2));
+	const auto pointer =
+	    Unary(state, spv::OpConvertUToPtr, TypePhysicalU32Pointer(state),
+	          Binary(state, spv::OpIAdd, TypeU64(state), address, offset));
+	state.builder.AddFunction(spv::OpStore, pointer, value, spv::MemoryAccessAlignedMask,
+	                          static_cast<uint32_t>(sizeof(uint32_t)));
+}
+
+uint32_t ToU32(EmitterState& state, uint32_t value, uint32_t type) {
+	return type == TypeU32(state) ? value : Unary(state, spv::OpBitcast, TypeU32(state), value);
+}
+
+// The compute form of EmitMeshEntryPoint. Group g of the dispatch (x + y * width) owns vertices
+// g * max_vertices onward of the output buffer, then its max_primitives triangles follow every
+// group's vertices as 32-bit indices. Unused and culled triangles repeat the group's first
+// vertex, so they cover no pixels. Layer goes with each vertex instead of each primitive.
+void EmitMeshComputeEntryPoint(EmitterState& state) {
+	const auto& mesh = state.input_info.vertex->mesh;
+	state.builder.AddFunction(spv::OpFunction, TypeVoid(state), state.main_func,
+	                          spv::FunctionControlMaskNone, TypeFunction(state));
