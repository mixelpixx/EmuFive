+	const auto vertex_dwords =
+	    EmitBinaryU32(state, spv::OpIMul, first_vertex, ConstantU32(state, stride));
+	const auto index_dwords = EmitAddU32(
+	    state, EmitBinaryU32(state, spv::OpIMul, groups,
+	                         ConstantU32(state, mesh.max_vertices * stride)),
+	    EmitBinaryU32(state, spv::OpIMul, group, ConstantU32(state, mesh.max_primitives * 3u)));
+
+	// Invocation indices cover this many triangle slots per pass (EmitLocalInvocationIndex).
+	uint32_t logical = 1;
+	for (const auto count: mesh.threads_num) {
+		logical *= count != 0 ? count : 1u;
+	}
+	const auto coverage = state.lane_count == 2 ? (logical + 63u) / 64u * 64u : logical;
+
+	for (uint32_t half = 0; half < state.lane_count; half++) {
+		state.lane_half      = half;
+		const auto index     = EmitLocalInvocationIndex(state);
+		const auto is_vertex = Binary(state, spv::OpULessThan, TypeBool(state), index, vertices);
+		EmitIfCondition(state, is_vertex, [&] {
+			const auto base = EmitAddU32(
+			    state, vertex_dwords, EmitBinaryU32(state, spv::OpIMul, index, ConstantU32(state, stride)));
+			uint32_t offset = 0;
+			for (const auto& output: state.outputs) {
+				const auto type   = MeshOutputType(state, output.kind);
+				const bool layer  = output.kind == IR::StageOutputKind::Layer;
+				const auto value  = layer ? MeshLoad(state, output.mesh_data_variable,
+				                                     spv::StorageClassWorkgroup, type, index)
+				                          : MeshLoad(state, output.mesh_data_variable,
