--- /dev/null
+++ b/src/graphics/shader/meshComputeShader.cpp
@@ -0,0 +1,251 @@
+#include "graphics/shader/meshComputeShader.h"
+
+#include "common/assert.h"
+#include "graphics/shader/recompiler/backend/spirv/SpirvBuilder.h"
+#include "graphics/shader/recompiler/ir/ShaderIR.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace Libs::Graphics {
+
+namespace {
+
+using ShaderRecompiler::IR::StageOutputKind;
+using ShaderRecompiler::Spirv::Builder;
+
+constexpr uint32_t SpirvVersion15 = 0x00010500u;
+
+class MeshComputeVertexEmitter {
+public:
+	explicit MeshComputeVertexEmitter(const ShaderRecompiler::IR::CompiledShaderInfo& mesh_)
+	    : mesh(mesh_) {}
+
+	std::vector<uint32_t> Emit() {
+		for (const auto& output: mesh.mesh_vertex_outputs) {
+			if (output.kind == StageOutputKind::ClipDistance) {
+				clip_count = std::max(clip_count, output.index + 1u);
+			} else if (output.kind == StageOutputKind::CullDistance) {
+				cull_count = std::max(cull_count, output.index + 1u);
+			} else if (output.kind == StageOutputKind::Layer) {
+				layer = true;
+			} else {
+				EXIT_IF(output.kind != StageOutputKind::Position &&
+				        output.kind != StageOutputKind::Parameter);
+			}
+		}
+		DefineTypes();
+		DefineInterface();
+		builder.RequireCapability(spv::CapabilityShader);
+		builder.RequireCapability(spv::CapabilityInt64);
+		builder.RequireCapability(spv::CapabilityPhysicalStorageBufferAddresses);
+		if (clip_count != 0) builder.RequireCapability(spv::CapabilityClipDistance);
+		if (cull_count != 0) builder.RequireCapability(spv::CapabilityCullDistance);
+		if (layer) builder.RequireCapability(spv::CapabilityShaderLayer);
+		builder.AddMemoryModel(spv::AddressingModelPhysicalStorageBuffer64,
+		                       spv::MemoryModelGLSL450);
+
+		main = Result(spv::OpFunction, void_type, spv::FunctionControlMaskNone, function_type);
+		builder.AddEntryPoint(spv::ExecutionModelVertex, main, "main", interfaces);
+		ResultWithoutType(spv::OpLabel);
+
+		const auto dword   = mesh.mesh_output_dword;
+		const auto pair    = Result(spv::OpCompositeConstruct, uvec2_type, PushDword(dword),
+		                            PushDword(dword + 1u));
+		address            = Result(spv::OpBitcast, u64_type, pair);
+		const auto vertex  = Result(spv::OpBitcast, uint_type, Load(int_type, vertex_index));
+		uint32_t   stride  = 0;
+		for (const auto& output: mesh.mesh_vertex_outputs) {
+			stride += ShaderRecompiler::IR::MeshComputeOutputDwords(output.kind);
+		}
+		const auto base = Result(spv::OpIMul, uint_type, vertex, Uint(stride));
+
+		uint32_t offset = 0;
+		size_t   parameter = 0;
+		for (const auto& output: mesh.mesh_vertex_outputs) {
+			switch (output.kind) {
+				case StageOutputKind::Position:
+					Store(Access(ptr_output_vec4, per_vertex, Uint(0)), LoadVec4(base, offset));
+					break;
+				case StageOutputKind::Parameter:
+					Store(parameters[parameter++], LoadVec4(base, offset));
+					break;
+				case StageOutputKind::ClipDistance:
+				case StageOutputKind::CullDistance: {
+					const auto member = output.kind == StageOutputKind::ClipDistance
+					                        ? clip_member : cull_member;
+					Store(Access(ptr_output_float, per_vertex, Uint(member), Uint(output.index)),
+					      Result(spv::OpBitcast, float_type, LoadDword(base, offset)));
+					break;
+				}
+				case StageOutputKind::Layer:
+					Store(layer_variable, LoadDword(base, offset));
+					break;
+				default: break;
+			}
+			offset += ShaderRecompiler::IR::MeshComputeOutputDwords(output.kind);
+		}
+
+		builder.AddFunction(spv::OpReturn);
+		builder.AddFunction(spv::OpFunctionEnd);
+		return builder.Build();
+	}
+
+private:
+	void DefineTypes() {
+		void_type     = builder.Type(spv::OpTypeVoid);
+		uint_type     = builder.Type(spv::OpTypeInt, 32u, 0u);
+		int_type      = builder.Type(spv::OpTypeInt, 32u, 1u);
+		u64_type      = builder.Type(spv::OpTypeInt, 64u, 0u);
+		float_type    = builder.Type(spv::OpTypeFloat, 32u);
+		uvec2_type    = builder.Type(spv::OpTypeVector, uint_type, 2u);
+		vec4_type     = builder.Type(spv::OpTypeVector, float_type, 4u);
+		function_type = builder.Type(spv::OpTypeFunction, void_type);
+		ptr_physical_uint = builder.Type(spv::OpTypePointer,
+		                                 spv::StorageClassPhysicalStorageBuffer, uint_type);
+		ptr_output_vec4  = Pointer(spv::StorageClassOutput, vec4_type);
+		ptr_output_float = Pointer(spv::StorageClassOutput, float_type);
+		ptr_push_uint    = Pointer(spv::StorageClassPushConstant, uint_type);
+	}
+
+	void DefineInterface() {
+		vertex_index = AddInterface(spv::StorageClassInput, int_type);
+		Decorate(vertex_index, spv::DecorationBuiltIn, spv::BuiltInVertexIndex);
+
+		const auto dwords = builder.DecoratedType(
+		    spv::OpTypeArray, {{spv::OpDecorate, {spv::DecorationArrayStride, 4u}}}, uint_type,
+		    Uint(ShaderRecompiler::IR::PushData::DwordCount));
+		const auto push_type = builder.DecoratedType(
+		    spv::OpTypeStruct,
+		    {{spv::OpMemberDecorate, {0u, spv::DecorationOffset, 0u}},
+		     {spv::OpDecorate, {spv::DecorationBlock}}},
+		    dwords);
+		push_data = AddInterface(spv::StorageClassPushConstant, push_type);
+
+		// gl_PerVertex: Position, then the clip and cull distance arrays present.
+		std::vector<uint32_t> members {vec4_type};
+		if (clip_count != 0) {
+			clip_member = static_cast<uint32_t>(members.size());
+			members.push_back(builder.Type(spv::OpTypeArray, float_type, Uint(clip_count)));
+		}
+		if (cull_count != 0) {
+			cull_member = static_cast<uint32_t>(members.size());
+			members.push_back(builder.Type(spv::OpTypeArray, float_type, Uint(cull_count)));
+		}
+		const auto per_vertex_type =
+		    builder.Type(spv::OpTypeStruct, std::span<const uint32_t>(members));
+		builder.AddAnnotation(spv::OpMemberDecorate, per_vertex_type, 0u, spv::DecorationBuiltIn,
+		                      spv::BuiltInPosition);
+		if (clip_count != 0) {
+			builder.AddAnnotation(spv::OpMemberDecorate, per_vertex_type, clip_member,
+			                      spv::DecorationBuiltIn, spv::BuiltInClipDistance);
+		}
+		if (cull_count != 0) {
+			builder.AddAnnotation(spv::OpMemberDecorate, per_vertex_type, cull_member,
+			                      spv::DecorationBuiltIn, spv::BuiltInCullDistance);
+		}
+		builder.AddAnnotation(spv::OpDecorate, per_vertex_type, spv::DecorationBlock);
+		per_vertex = AddInterface(spv::StorageClassOutput, per_vertex_type);
+
+		for (const auto& output: mesh.mesh_vertex_outputs) {
+			if (output.kind == StageOutputKind::Parameter) {
+				const auto variable = AddInterface(spv::StorageClassOutput, vec4_type);
+				Decorate(variable, spv::DecorationLocation, output.location);
+				parameters.push_back(variable);
+			}
+		}
+		if (layer) {
+			layer_variable = AddInterface(spv::StorageClassOutput, uint_type);
+			Decorate(layer_variable, spv::DecorationBuiltIn, spv::BuiltInLayer);
+		}
+	}
+
+	uint32_t PushDword(uint32_t index) {
+		return Load(uint_type, Access(ptr_push_uint, push_data, Uint(0), Uint(index)));
+	}
+
+	// Dword base + offset of the output buffer.
+	uint32_t LoadDword(uint32_t base, uint32_t offset) {
+		const auto dword  = Result(spv::OpIAdd, uint_type, base, Uint(offset));
+		const auto bytes  = Result(spv::OpShiftLeftLogical, u64_type,
+		                           Result(spv::OpUConvert, u64_type, dword),
+		                           builder.Constant(spv::OpConstant, u64_type, 2u, 0u));
+		const auto pointer = Result(spv::OpConvertUToPtr, ptr_physical_uint,
+		                            Result(spv::OpIAdd, u64_type, address, bytes));
+		const auto value = builder.AllocateId();
+		builder.AddFunction(spv::OpLoad, uint_type, value, pointer, spv::MemoryAccessAlignedMask,
+		                    static_cast<uint32_t>(sizeof(uint32_t)));
+		return value;
+	}
+
+	uint32_t LoadVec4(uint32_t base, uint32_t offset) {
+		std::array<uint32_t, 4> components {};
+		for (uint32_t i = 0; i < 4; i++) {
+			components[i] = Result(spv::OpBitcast, float_type, LoadDword(base, offset + i));
+		}
+		return Result(spv::OpCompositeConstruct, vec4_type, components[0], components[1],
+		              components[2], components[3]);
+	}
+
+	uint32_t Pointer(spv::StorageClass storage, uint32_t type) {
+		return builder.Type(spv::OpTypePointer, storage, type);
+	}
+
+	template <typename... Args>
+	uint32_t Result(spv::Op opcode, uint32_t type, Args... operands) {
+		const auto id = builder.AllocateId();
+		builder.AddFunction(opcode, type, id, operands...);
+		return id;
+	}
+
+	template <typename... Args>
+	uint32_t ResultWithoutType(spv::Op opcode, Args... operands) {
+		const auto id = builder.AllocateId();
+		builder.AddFunction(opcode, id, operands...);
+		return id;
+	}
+
+	template <typename... Args>
+	uint32_t Access(uint32_t pointer_type, uint32_t base, Args... indices) {
+		return Result(spv::OpAccessChain, pointer_type, base, indices...);
+	}
+
+	uint32_t Load(uint32_t type, uint32_t pointer) { return Result(spv::OpLoad, type, pointer); }
+
+	void Store(uint32_t pointer, uint32_t value) { builder.AddFunction(spv::OpStore, pointer, value); }
+
+	uint32_t Uint(uint32_t value) { return builder.Constant(spv::OpConstant, uint_type, value); }
+
+	uint32_t AddInterface(spv::StorageClass storage, uint32_t type) {
+		const auto variable = builder.DefineGlobalVariable(Pointer(storage, type), storage);
+		interfaces.push_back(variable);
+		return variable;
+	}
+
+	void Decorate(uint32_t target, spv::Decoration decoration, uint32_t value) {
+		builder.AddAnnotation(spv::OpDecorate, target, decoration, value);
+	}
+
+	const ShaderRecompiler::IR::CompiledShaderInfo& mesh;
+	Builder                                         builder {SpirvVersion15};
+	std::vector<uint32_t>                           interfaces;
+	std::vector<uint32_t>                           parameters;
+	uint32_t clip_count = 0, cull_count = 0, clip_member = 0, cull_member = 0;
+	bool     layer = false;
+	uint32_t main = 0, void_type = 0, uint_type = 0, int_type = 0, u64_type = 0, float_type = 0;
+	uint32_t uvec2_type = 0, vec4_type = 0, function_type = 0, ptr_physical_uint = 0;
+	uint32_t ptr_output_vec4 = 0, ptr_output_float = 0, ptr_push_uint = 0;
+	uint32_t vertex_index = 0, push_data = 0, per_vertex = 0, layer_variable = 0, address = 0;
+};
+
+} // namespace
+
+std::vector<uint32_t> BuildMeshComputeVertexShader(
+    const ShaderRecompiler::IR::CompiledShaderInfo& mesh) {
+	return MeshComputeVertexEmitter(mesh).Emit();
+}
+
+} // namespace Libs::Graphics
