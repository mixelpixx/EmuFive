+bool UseMeshCompute(const GraphicContext& graphics) {
+	const char* forced = std::getenv("KYTY_MESH_COMPUTE");
+	return !graphics.mesh_shader_enabled || (forced != nullptr && std::strcmp(forced, "1") == 0);
+}
