+
+#include <cstdint>
+#include <vector>
+
+namespace Libs::Graphics {
+
+namespace ShaderRecompiler::IR {
+struct CompiledShaderInfo;
+} // namespace ShaderRecompiler::IR
+
+// The vertex shader that draws what a mesh shader run as compute wrote: vertex gl_VertexIndex's
+// outputs, in mesh_vertex_outputs order, from the buffer whose device address is in push dwords
+// mesh_output_dword and mesh_output_dword + 1.
