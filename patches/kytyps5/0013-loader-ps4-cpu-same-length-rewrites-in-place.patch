 			totals.clwb += result.clwb;
 			totals.rdtsc += result.rdtsc;
 			totals.jaguar += result.jaguar;
+			totals.jaguar_in_place += result.jaguar_in_place;
 			if (protect_memory_faults) {
 				LOGF("Windows guest red-zone patching: %s, functions=%" PRIu64 ", red_zone=%" PRIu64
 				     ", memory=%" PRIu64 ", patched=%" PRIu64 ", short=%" PRIu64 ", stack=%" PRIu64
@@ -1897,9 +1898,10 @@ void RuntimeLinker::LoadProgramToMemory(Program* program) {
 		if (emulate_jaguar && have_function_starts) {
 			const auto& counts = totals.jaguar;
 			Log::WriteToConsoleAndLog(fmt::format(
-			    "PS4 CPU compatibility: {} AVX2/FMA/BMI2 instructions: {} found, {} rewritten, {} "
-			    "replaced when first run\n",
-			    module_name, counts.found, counts.native, counts.found - counts.native));
+			    "PS4 CPU compatibility: {} instructions the CPU lacks (AVX2, FMA, BMI2 and others): {} "
+			    "found, {} rewritten ({} in place), {} replaced when first run\n",
+			    module_name, counts.found, counts.native, totals.jaguar_in_place,
+			    counts.found - counts.native));
 		}
 		if (emulate_amd && have_function_starts) {
 			InstructionPatchCounts combined {};
