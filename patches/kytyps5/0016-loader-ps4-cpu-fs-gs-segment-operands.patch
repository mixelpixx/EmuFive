From: mixelpixx <11727006+mixelpixx@users.noreply.github.com>
Subject: [PATCH] loader: PS4 CPU replacements keep FS/GS segment overrides

An AVX2/FMA/BMI2 instruction whose memory operand has an FS or GS
override (thread-local storage) had no replacement: Emitter::Mem and
GenerateGather refused the segment, so the site faulted when it ran.

The Emitter now notes the guest operand's FS/GS override, and Emit
encodes it on every instruction that accesses that operand, so the
replacement reaches the same memory as the original. A gather computes
its address without the override (LEA) and puts the prefix on each
element's load. In-place rewrites and relocated spans already kept it.
---
diff --git a/src/loader/jaguarCompat.cpp b/src/loader/jaguarCompat.cpp
--- a/src/loader/jaguarCompat.cpp
+++ b/src/loader/jaguarCompat.cpp
@@ -74,6 +74,11 @@ public:
 			if (op.type == ZYDIS_OPERAND_TYPE_REGISTER && IsVector(op.reg.value)) {
 				used_vectors |= 1u << VectorId(op.reg.value);
 			}
+			if (op.type == ZYDIS_OPERAND_TYPE_MEMORY) {
+				segment = op.mem.segment == ZYDIS_REGISTER_FS   ? ZYDIS_ATTRIB_HAS_SEGMENT_FS
+				          : op.mem.segment == ZYDIS_REGISTER_GS ? ZYDIS_ATTRIB_HAS_SEGMENT_GS
+				                                                : 0;
+			}
 		}
 	}
 
@@ -85,6 +90,10 @@ public:
 	bool                           ok           = true;
 	uint32_t                       used_vectors = 0;
 	bool                           flags_live   = true; // RFLAGS are read before being rewritten.
+	// The guest memory operand's FS or GS override (thread-local storage), as an encoder prefix:
+	// every access to that operand keeps it, so it reaches the same memory as the original. The
+	// other overrides change nothing in 64-bit mode.
+	ZydisInstructionAttributes segment = 0;
 
 	// A vector register the guest instruction does not name, for scratch use.
 	int Scratch() {
@@ -98,15 +107,14 @@ public:
 		return 0;
 	}
 
-	// Guest memory operand `index`, `extra` bytes further on, `size` bytes wide.
+	// Guest memory operand `index`, `extra` bytes further on, `size` bytes wide (with its FS/GS
+	// override when Emit encodes it).
 	ZydisEncoderOperand Mem(int index, int64_t extra, uint16_t size) {
 		const auto&         op = ops[index];
 		ZydisEncoderOperand operand {};
 		operand.type     = ZYDIS_OPERAND_TYPE_MEMORY;
 		operand.mem.size = size;
-		if (op.type != ZYDIS_OPERAND_TYPE_MEMORY || in.address_width != 64 ||
-		    (op.mem.segment != ZYDIS_REGISTER_DS && op.mem.segment != ZYDIS_REGISTER_SS &&
-		     op.mem.segment != ZYDIS_REGISTER_NONE)) {
+		if (op.type != ZYDIS_OPERAND_TYPE_MEMORY || in.address_width != 64) {
 			ok = false;
 			return operand;
 		}
@@ -162,6 +170,10 @@ public:
 			if (i == 3 && operand.type == ZYDIS_OPERAND_TYPE_REGISTER) {
 				request.operands[i].reg.is4 = ZYAN_TRUE;
 			}
+			// Memory here is the guest's (Mem); LEA only computes the offset, without the segment.
+			if (operand.type == ZYDIS_OPERAND_TYPE_MEMORY && mnemonic != ZYDIS_MNEMONIC_LEA) {
+				request.prefixes = segment;
+			}
 			++i;
 		}
 		std::array<uint8_t, ZYDIS_MAX_INSTRUCTION_LENGTH> code {};
@@ -1132,11 +1144,13 @@ bool GenerateGather(Emitter& e) {
 		return false;
 	}
 	const auto& m = e.ops[1].mem;
-	if (!IsVector(m.index) || m.base == ZYDIS_REGISTER_RIP || e.in.address_width != 64 ||
-	    (m.segment != ZYDIS_REGISTER_DS && m.segment != ZYDIS_REGISTER_SS &&
-	     m.segment != ZYDIS_REGISTER_NONE)) {
+	if (!IsVector(m.index) || m.base == ZYDIS_REGISTER_RIP || e.in.address_width != 64) {
 		return false;
 	}
+	// An FS/GS override goes on each element's load (the address is computed without it).
+	const uint8_t segment = m.segment == ZYDIS_REGISTER_FS   ? 0x64
+	                        : m.segment == ZYDIS_REGISTER_GS ? 0x65
+	                                                         : 0;
 	bool qword_data  = false;
 	bool qword_index = false;
 	switch (e.in.mnemonic) {
@@ -1190,6 +1204,9 @@ bool GenerateGather(Emitter& e) {
 		} else {
 			e.g.movsxd(rax, dword[rsp + Index + i * 4]);
 		}
+		if (segment != 0) {
+			e.g.db(segment); // Legacy prefixes go before REX, which Xbyak writes next.
+		}
 		if (qword_data) {
 			e.g.mov(rdx, ptr[rcx + rax * scale]);
 			e.g.mov(ptr[rsp + Dest + i * 8], rdx);
