-	// Guest register operand `index` = work (64-bit register; a 32-bit result is zero-extended).
+	// Guest register operand `index` = work (64-bit register; a 32-bit result is zero-extended,
+	// a 16-bit one keeps the upper bits).
 	void Write(int index, ZydisRegister work, int bits) {
 		const auto& op    = e.ops[index];
