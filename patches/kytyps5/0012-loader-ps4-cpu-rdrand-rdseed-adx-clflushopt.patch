From: mixelpixx <11727006+mixelpixx@users.noreply.github.com>
Subject: [PATCH] loader: PS4 CPU replacements for RDRAND, RDSEED, ADCX, ADOX, CLFLUSHOPT

Zen 2 has these and Jaguar does not; nothing handled them, so guest code
that uses them without a CPUID check faulted. They are now part of
JaguarCompat::IsMissing, so both the load-time and the run-time path
replace them:

- RDRAND/RDSEED: splitmix64 over a shared counter (LOCK XADD) seeded from
  host randomness, CF = 1 and the other status flags 0. Not a
  cryptographic generator.
- ADCX/ADOX: ADC with the carry in CF, the carry out merged into the
  saved RFLAGS, so only CF (ADCX) or OF (ADOX) changes.
- CLFLUSHOPT: CLFLUSH, which is the same flush with stronger ordering.

At load time, an instruction in a decoded function that the PS4's CPU
lacks and nothing here handles is now logged once per mnemonic, so a later
SIGILL can be explained from the log.
---
diff --git a/src/loader/guestInstructionPatcher.cpp b/src/loader/guestInstructionPatcher.cpp
--- a/src/loader/guestInstructionPatcher.cpp
+++ b/src/loader/guestInstructionPatcher.cpp
@@ -1076,11 +1076,66 @@ bool FlagsLiveAfter(const DecodedFunction& function, const DecodedCodeInstructio
 	return true;
 }
 
+// Whether the PS4's CPU has the instruction, or KytyPS5 handles it some other way: SHA and
+// MONITORX/MWAITX are emulated when they fault, RDPID and CLWB rewritten (CollectAmdInstructions),
+// JaguarCompat::IsMissing ones replaced.
+bool RunsOnJaguar(const ZydisDecodedInstruction& instruction) {
+	switch (instruction.meta.isa_ext) {
+		case ZYDIS_ISA_EXT_BASE:
+		case ZYDIS_ISA_EXT_LONGMODE:
+		case ZYDIS_ISA_EXT_X87:
+		case ZYDIS_ISA_EXT_MMX:
+		case ZYDIS_ISA_EXT_SSE:
+		case ZYDIS_ISA_EXT_SSE2:
+		case ZYDIS_ISA_EXT_SSE3:
+		case ZYDIS_ISA_EXT_SSSE3:
+		case ZYDIS_ISA_EXT_SSE4:
+		case ZYDIS_ISA_EXT_SSE4A:
+		case ZYDIS_ISA_EXT_AVX:
+		case ZYDIS_ISA_EXT_AVXAES:
+		case ZYDIS_ISA_EXT_AES:
+		case ZYDIS_ISA_EXT_PCLMULQDQ:
+		case ZYDIS_ISA_EXT_F16C:
+		case ZYDIS_ISA_EXT_BMI1:
+		case ZYDIS_ISA_EXT_LZCNT:
+		case ZYDIS_ISA_EXT_MOVBE:
+		case ZYDIS_ISA_EXT_CLFSH:
+		case ZYDIS_ISA_EXT_PAUSE:
+		case ZYDIS_ISA_EXT_RDTSCP:
+		case ZYDIS_ISA_EXT_XSAVE:
+		case ZYDIS_ISA_EXT_XSAVEOPT:
+		case ZYDIS_ISA_EXT_MONITOR:
+		case ZYDIS_ISA_EXT_AMD3DNOW_PREFETCH:
+		case ZYDIS_ISA_EXT_SHA:
+		case ZYDIS_ISA_EXT_MONITORX:
+		case ZYDIS_ISA_EXT_RDPID:
+		case ZYDIS_ISA_EXT_CLWB: return true;
+		case ZYDIS_ISA_EXT_CET:
+			// Hint NOPs to a CPU without CET.
+			return instruction.mnemonic == ZYDIS_MNEMONIC_ENDBR64 ||
+			       instruction.mnemonic == ZYDIS_MNEMONIC_ENDBR32;
+		default: return JaguarCompat::IsMissing(instruction);
+	}
+}
+
 void CollectJaguarInstructions(const DecodedFunction&                   function,
                                std::map<uintptr_t, InstructionRewrite>& rewrite_sites,
                                GuestInstructionPatchResult&             result) {
 	for (const auto& [address, decoded]: function.instructions) {
 		if (!JaguarCompat::IsMissing(decoded.instruction)) {
+			if (!RunsOnJaguar(decoded.instruction)) {
+				// Possibly behind a CPUID check; report each kind once, so a later SIGILL makes
+				// sense in the log.
+				static std::bitset<ZYDIS_MNEMONIC_MAX_VALUE + 1> reported;
+				if (!reported.test(decoded.instruction.mnemonic)) {
+					reported.set(decoded.instruction.mnemonic);
+					std::printf("PS4 CPU compatibility: %s (%s) at %p is not on this CPU and has no "
+					            "replacement; it faults if it runs\n",
+					            ZydisMnemonicGetString(decoded.instruction.mnemonic),
+					            ZydisISAExtGetString(decoded.instruction.meta.isa_ext),
+					            reinterpret_cast<void*>(address));
+				}
+			}
 			continue;
 		}
 		++result.jaguar.found;
@@ -1090,7 +1145,7 @@ void CollectJaguarInstructions(const DecodedFunction&                   function
 	}
 }
 
-// Whether a linear pass over [start, end) meets an AVX2, FMA or BMI2 instruction. Functions
+// Whether a linear pass over [start, end) meets an AVX2, FMA, BMI2 (or other missing) instruction. Functions
 // without one are not decoded when nothing else is patched; anything missed traps at run time.
 bool MayUseJaguarMissing(uintptr_t start, uintptr_t end) {
 	ZydisDecodedInstruction instruction;
