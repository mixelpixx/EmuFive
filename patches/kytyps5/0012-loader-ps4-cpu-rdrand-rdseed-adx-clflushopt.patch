+// Replacements for AVX2, FMA and BMI2 instructions (and RDRAND, RDSEED, ADX, CLFLUSHOPT) built
+// from what the PS4's Jaguar CPU has (SSE4.2, AVX, BMI1, F16C). See jaguarCompat.h.
 
 #include "loader/jaguarCompat.h"
 
 #include <algorithm>
