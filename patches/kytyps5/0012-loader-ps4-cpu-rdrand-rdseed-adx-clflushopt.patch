 }
 
+// ---------------------------------------------------------------------------------------------
+// Other instructions Zen 2 has and the PS4's CPU does not (legacy encoded).
+
+// RDRAND/RDSEED values: splitmix64 over a shared counter seeded from host randomness. Different on
+// every run and statistically sound, but not a cryptographic generator: whoever sees one value can
+// work out the next ones.
+alignas(64) uint64_t g_random_state = [] {
+	std::random_device device;
+	return (uint64_t {device()} << 32 ^ device()) ^
+	       static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count());
+}();
+
+bool GenerateLegacy(Emitter& e) {
+	switch (e.in.mnemonic) {
+		case ZYDIS_MNEMONIC_RDRAND:
+		case ZYDIS_MNEMONIC_RDSEED: {
+			if (e.in.operand_count_visible != 1 || e.ops[0].type != ZYDIS_OPERAND_TYPE_REGISTER ||
+			    UsesStackPointer(e)) {
+				return false;
+			}
+			const int bits = e.ops[0].size;
+			// Every flag is written, so none are saved: CF = 1 (a value was ready) and
+			// OF = SF = ZF = AF = PF = 0, as 0 - 0xF0 leaves them in CMP.
+			GprWork w(e, {ZYDIS_REGISTER_RAX, ZYDIS_REGISTER_RCX, ZYDIS_REGISTER_RDX}, false);
+			e.g.mov(rdx, reinterpret_cast<uint64_t>(&g_random_state));
+			e.g.mov(rcx, 0x9e3779b97f4a7c15);
+			e.g.mov(rax, rcx);
+			e.g.lock();
+			e.g.xadd(ptr[rdx], rax);
+			e.g.add(rax, rcx);
+			const std::pair<int, uint64_t> steps[] = {{30, 0xbf58476d1ce4e5b9},
+			                                          {27, 0x94d049bb133111eb}};
+			for (const auto& [shift, multiplier]: steps) {
+				e.g.mov(rcx, rax);
+				e.g.shr(rcx, shift);
+				e.g.xor_(rax, rcx);
+				e.g.mov(rcx, multiplier);
+				e.g.imul(rax, rcx);
+			}
+			e.g.mov(rcx, rax);
+			e.g.shr(rcx, 31);
+			e.g.xor_(rax, rcx);
+			e.g.xor_(ecx, ecx);
+			e.g.cmp(cl, 0xf0);
+			w.Write(0, ZYDIS_REGISTER_RAX, bits);
+			w.Finish();
+			return e.ok;
+		}
+		case ZYDIS_MNEMONIC_ADCX:
+		case ZYDIS_MNEMONIC_ADOX: {
+			// ADCX adds with carry in and out through CF and leaves the other flags; ADOX does
+			// the same through OF. ADC does the addition with the carry in CF, and its carry out
+			// goes into the saved RFLAGS that Finish() restores.
+			const int bits = e.ops[0].size;
+			if (e.in.operand_count_visible != 2 || e.ops[0].type != ZYDIS_OPERAND_TYPE_REGISTER ||
+			    (bits != 32 && bits != 64) || UsesStackPointer(e)) {
+				return false;
+			}
+			const bool carry = e.in.mnemonic == ZYDIS_MNEMONIC_ADCX;
+			GprWork    w(e, {ZYDIS_REGISTER_RAX, ZYDIS_REGISTER_RCX}, true);
+			const int  flags = w.FlagsSlot();
+			// The source (register or memory) first, while the guest registers that may address
+			// it are unchanged. MOV and PUSH leave CF as the guest had it.
+			w.Read(ZYDIS_REGISTER_RCX, 1, bits);
+			w.Read(ZYDIS_REGISTER_RAX, 0, bits);
+			if (!carry) {
+				e.g.bt(qword[rsp + flags], 11); // CF = the guest's OF.
+			}
+			if (bits == 64) {
+				e.g.adc(rax, rcx);
+			} else {
+				e.g.adc(eax, ecx);
+			}
+			e.g.setc(cl);
+			e.g.movzx(ecx, cl);
+			if (!carry) {
+				e.g.shl(ecx, 11);
+			}
+			e.g.and_(qword[rsp + flags], carry ? ~0x001 : ~0x800);
+			e.g.or_(qword[rsp + flags], rcx);
+			w.Write(0, ZYDIS_REGISTER_RAX, bits);
+			w.Finish();
+			return e.ok;
+		}
+		case ZYDIS_MNEMONIC_CLFLUSHOPT:
+			// CLFLUSH: the same flush and invalidation, more strongly ordered.
+			if (e.in.operand_count_visible != 1 || e.ops[0].type != ZYDIS_OPERAND_TYPE_MEMORY) {
+				return false;
+			}
+			e.Emit(ZYDIS_MNEMONIC_CLFLUSH, {e.Copy(0)});
+			return e.ok;
+		default: return false;
+	}
+}
+
