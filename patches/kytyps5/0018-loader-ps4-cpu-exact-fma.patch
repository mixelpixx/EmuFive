+	const bool         ftz      = (mxcsr & 0x8000) != 0;
+	const int          rounding = static_cast<int>((mxcsr >> 13) & 3); // Nearest, down, up, zero.
+	struct Value {
+		U128 m;    // Significand.
+		int  e;    // Exponent of its lowest bit.
+		int  sign;
+	};
+	const auto unpack = [daz](uint64_t x) {
+		const int      exponent = static_cast<int>((x >> 52) & 0x7ff);
+		const uint64_t m        = x & ((One << 52) - 1);
+		const int      sign     = static_cast<int>(x >> 63);
+		if (exponent == 0) {
+			return Value {daz ? 0 : m, -1074, sign};
+		}
+		return Value {m | (One << 52), exponent - 1075, sign};
+	};
+	const auto width = [](U128 v) {
+		const auto high = static_cast<uint64_t>(v >> 64);
+		const auto low  = static_cast<uint64_t>(v);
+		return high != 0 ? 128 - __builtin_clzll(high) : low != 0 ? 64 - __builtin_clzll(low) : 0;
+	};
