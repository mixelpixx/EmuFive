+// The lanes a double-precision FMA left to it (GenerateExactFmaDouble). `flags`: the lane
+// count, plus 8 when the product is negated. Where c is the only NaN, the result is c's NaN,
+// quieted (the plain sum has the new NaN of 0 times infinity there, where there is one). Where
+// only c is infinite, it is c: the exact a*b is finite, also where ph overflowed. Other lanes with
+// a NaN or infinite input get the plain result, which has a's or b's NaN where there is one.
+void FmaFallback(uint64_t* frame, uint32_t flags) {
+	constexpr uint64_t Sign   = uint64_t {1} << 63;
+	constexpr uint64_t Quiet  = uint64_t {1} << 51;
+	const auto         finite = [](uint64_t x) { return ((x >> 52) & 0x7ff) != 0x7ff; };
+	const auto         nan    = [](uint64_t x) { return (x & ~Sign) > 0x7ff0000000000000; };
+	const auto         lane   = [frame](int slot, uint32_t i) -> uint64_t& { return frame[slot * 4 + i]; };
+	const uint32_t     mxcsr  = _mm_getcsr();
+	for (uint32_t i = 0; i < (flags & 7); ++i) {
+		if ((lane(SlotOk, i) & Sign) != 0) {
+			continue;
+		}
+		const uint64_t a = lane(SlotA, i) ^ ((flags & 8) != 0 ? Sign : 0);
+		const uint64_t b = lane(SlotB, i);
+		const uint64_t c = lane(SlotC, i);
+		if (!nan(a) && !nan(b) && nan(c)) {
+			lane(SlotResult, i) = lane(SlotGuestC, i) | Quiet;
+		} else if (finite(a) && finite(b)) {
+			lane(SlotResult, i) = finite(c) ? ExactFma(a, b, c, mxcsr) : c;
+		} else {
+			lane(SlotResult, i) = lane(SlotPlain, i);
+		}
 	}
