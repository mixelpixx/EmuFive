+// The frame a double-precision FMA keeps on the stack, 32 bytes (four lanes) per slot. All but
+// the last are for FmaFallback.
+enum FmaSlot : int {
+	SlotA,      // a.
+	SlotB,      // b.
+	SlotC,      // c, negated in the lanes that subtract it.
+	SlotGuestC, // c as the guest has it.
+	SlotPlain,  // a*b +/- c rounded: the result where a*b is exact.
+	SlotResult, // The result.
+	SlotOk,     // All ones in the lanes the vector code got exact.
+	SlotPl,     // a*b - ph, exactly.
